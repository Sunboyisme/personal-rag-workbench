{
  "name": "personal-rag-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "个人 RAG 知识库 + 实验工作台",
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "install:all": "npm install && npm install --prefix client",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "uuid": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
